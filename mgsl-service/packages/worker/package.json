{
  "name": "@mgsl/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local --persist-to=.wrangler/state",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply mgsl --local",
    "db:migrate:remote": "wrangler d1 migrations apply mgsl --remote"
  },
  "dependencies": {
    "@mgsl/shared": "workspace:*",
    "@tsndr/cloudflare-worker-jwt": "^3.1.4",
    "hono": "^4.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.16",
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.10"
  }
}
